<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bỏ qua các tệp tin hoặc thư mục thực tế tồn tại trong public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Chuyển hướng toàn bộ các URL còn lại về index.php
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>