// ==========================================================
// XUẤT CÁC BÁO CÁO THÀNH HÌNH ẢNH PNG
// ==========================================================

function safeFileName(text) {
  return String(text || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/đ/g, 'd')
    .replace(/Đ/g, 'D')
    .replace(/[^a-zA-Z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

async function exportReportImage(elementId, reportName) {
  if (typeof html2canvas === 'undefined') {
    alert('Thư viện xuất hình ảnh chưa được tải.');
    return;
  }

  const element = $(elementId);

  if (!element) {
    alert('Không tìm thấy nội dung cần xuất.');
    return;
  }

  const studentName = $('sname')?.textContent?.trim() || 'Hoc-Sinh';
  const month = $('month')?.value || new Date().toISOString().slice(0, 7);
  const fileName = `${reportName}-${safeFileName(studentName) || 'Hoc-Sinh'}-${month}.png`;

  const buttons = element.querySelectorAll('.export-image-btn');
  buttons.forEach(btn => btn.style.display = 'none');

  try {
    const canvas = await html2canvas(element, {
      scale: 2,
      backgroundColor: '#ffffff',
      useCORS: true,
      logging: false
    });

    // Chuyển canvas trực tiếp thành Data URL.
    // Cách này không tạo blob:http://... nên tránh cảnh báo insecure connection.
    const dataUrl = canvas.toDataURL('image/png');

    const link = document.createElement('a');
    link.href = dataUrl;
    link.download = fileName;
    link.style.display = 'none';

    document.body.appendChild(link);
    link.click();
    link.remove();

  } catch (error) {
    console.error('Export image error:', error);
    alert('Không thể xuất hình ảnh: ' + error.message);
  } finally {
    buttons.forEach(btn => btn.style.display = '');
  }
}

function exportOverviewImage() {
  exportReportImage('overview', 'Phieu-hoc-phi-bao-cao');
}

function exportLessonsImage() {
  exportReportImage('lessons', 'Nhat-ky-buoi-hoc');
}

function exportGradesImage() {
  exportReportImage('grades', 'Bang-diem-chi-tiet');
}

function showTab(id) {
  document.querySelectorAll('.page').forEach(x => x.classList.add('hidden'));
  $(id).classList.remove('hidden');
  document.querySelectorAll('.tab').forEach(x => x.classList.remove('active'));
  const word = id === 'overview' ? 'phiếu' : id === 'lessons' ? 'nhật ký' : 'bảng điểm';
  document.querySelectorAll('.tab').forEach(x => {
    if (x.textContent.toLowerCase().includes(word)) x.classList.add('active');
  });
}

function openModal() {
  $('modal').classList.remove('hidden');
  $('modal').classList.add('flex');
}

function closeModal() {
  $('modal').classList.add('hidden');
  $('modal').classList.remove('flex');
}

function toggleSide() {
  $('side').classList.toggle('open');
  $('overlay').classList.toggle('hidden');
}

function money(n) {
  return new Intl.NumberFormat('vi-VN').format(Number(n) || 0) + ' đ';
}

function fmtDate(d) {
  return new Date(d + 'T00:00:00').toLocaleDateString('vi-VN');
}

function esc(s) {
  return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

function field(label, name, value = '', required = false, type = 'text', step = '', min = '', max = '', placeholder = '') {
  let attr = `type="${type}" name="${name}" ${required ? 'required' : ''}`;
  if (step) attr += ` step="${step}"`;
  if (min !== '') attr += ` min="${min}"`;
  if (max !== '') attr += ` max="${max}"`;
  if (placeholder) attr += ` placeholder="${esc(placeholder)}"`;

  if (type === 'file') {
    return `<label class="label">${label}<input ${attr} class="input"></label>`;
  }
  return `<label class="label">${label}<input ${attr} value="${esc(value)}" class="input"></label>`;
}

loadStudents();
